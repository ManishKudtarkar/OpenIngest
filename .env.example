# OpenIngest Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# Required — PostgreSQL connection string for the staging warehouse
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/openingest

# ─────────────────────────────────────────────────────────────────────────────
# Cloud Storage (uncomment the ones you need)
# ─────────────────────────────────────────────────────────────────────────────

# Amazon S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1

# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# Google Cloud Storage
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─────────────────────────────────────────────────────────────────────────────
# Database Connectors
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL source (separate from the staging target above)
# PG_HOST=localhost
# PG_DATABASE=production
# PG_USER=reader
# PG_PASSWORD=password

# MySQL
# MYSQL_HOST=localhost
# MYSQL_DATABASE=production
# MYSQL_USER=reader
# MYSQL_PASSWORD=password

# MongoDB
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net

# ─────────────────────────────────────────────────────────────────────────────
# File Transfer
# ─────────────────────────────────────────────────────────────────────────────

# SFTP
# SFTP_HOST=sftp.company.com
# SFTP_USER=data_user
# SFTP_PASSWORD=password
# SFTP_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# FTP
# FTP_HOST=ftp.company.com
# FTP_USER=data_user
# FTP_PASSWORD=password

# ─────────────────────────────────────────────────────────────────────────────
# SaaS Connectors
# ─────────────────────────────────────────────────────────────────────────────

# Salesforce
# SF_USERNAME=user@company.com
# SF_PASSWORD=password
# SF_SECURITY_TOKEN=token
# SF_CLIENT_ID=consumer_key
# SF_CLIENT_SECRET=consumer_secret

# HubSpot
# HUBSPOT_ACCESS_TOKEN=pat-na1-...

# Stripe
# STRIPE_API_KEY=sk_live_...

# Google Sheets
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# REST API (generic)
# API_TOKEN=your_bearer_token
# ORDERS_API_TOKEN=your_orders_api_token

# ─────────────────────────────────────────────────────────────────────────────
# Notifications (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Email (SMTP)
# EMAIL_USERNAME=pipeline@company.com
# EMAIL_PASSWORD=app_password
